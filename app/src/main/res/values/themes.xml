<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@drawable/splash_background</item>

        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <item name="postSplashScreenTheme">@style/Theme.FlowCapital</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.FlowCapital" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
    </style>
</resources>